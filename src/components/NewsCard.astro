---
import Badge from './Badge.astro';

interface Props {
  title: string;
  date: Date;
  author: string;
  tag: string;
  excerpt: string;
  slug: string;
}

const { title, date, author, tag, excerpt, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="news-card">
  <div class="news-card-meta">
    <Badge label={tag} />
    <span class="meta-text">{formattedDate} · {author}</span>
  </div>
  <h3 class="news-card-title">
    <a href={`/news/${slug}/`}>{title}</a>
  </h3>
  <p class="news-card-excerpt">{excerpt}</p>
</article>

<style>
.news-card {
  background: #fff;
  border: 1px solid #e8e6df;
  border-radius: 12px;
  padding: 28px;
}
.news-card-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}
.meta-text {
  font-size: 13px;
  color: #888780;
  font-family: 'DM Sans', sans-serif;
}
.news-card-title {
  margin: 0 0 8px;
  font-size: 19px;
  font-weight: 500;
  line-height: 1.3;
}
.news-card-title a {
  text-decoration: none;
  color: #2C2C2A;
}
.news-card-title a:hover {
  color: #1a4d2e;
}
.news-card-excerpt {
  margin: 0;
  font-size: 15px;
  color: #5F5E5A;
  line-height: 1.65;
  font-family: 'DM Sans', sans-serif;
}
</style>
