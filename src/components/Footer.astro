---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    © {year} Washington Place Improvement Association. All rights reserved.
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid #e8e6df;
  padding: 0 24px;
  margin-top: 60px;
}
.footer-inner {
  max-width: 960px;
  margin: 0 auto;
  padding: 24px 0;
  text-align: center;
  font-size: 13px;
  color: #888780;
  font-family: 'DM Sans', sans-serif;
}
</style>
