---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-location">Washington Place · A historic neighborhood in St. Louis, Missouri</p>
    <p class="footer-copyright">© {year} Washington Place Improvement Association (WPIA). All rights reserved.</p>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid #e8e6df;
  padding: 0 24px;
  margin-top: 60px;
}
.footer-inner {
  max-width: 960px;
  margin: 0 auto;
  padding: 24px 0;
  text-align: center;
  font-family: 'DM Sans', sans-serif;
}
.footer-location {
  margin: 0 0 4px;
  font-size: 13px;
  color: #5F5E5A;
}
.footer-copyright {
  margin: 0;
  font-size: 12px;
  color: #888780;
}
</style>
