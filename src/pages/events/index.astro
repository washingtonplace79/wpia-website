---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');

const today = new Date();
today.setUTCHours(0, 0, 0, 0);

const upcoming = allEvents
  .filter(e => e.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = allEvents
  .filter(e => e.data.date < today)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Events | Washington Place Improvement Association">
  <div class="page-header">
    <h2>Upcoming events</h2>
  </div>

  <div class="event-list" id="upcoming-list" hidden={upcoming.length === 0}>
    {upcoming.map(event => (
      <EventCard
        title={event.data.title}
        date={event.data.date}
        startTime={event.data.startTime}
        endTime={event.data.endTime}
        location={event.data.location}
        type={event.data.type}
        featured={event.data.featured}
        slug={event.id.replace(/\.mdx?$/, '')}
      />
    ))}
  </div>
  <p class="empty-state" id="upcoming-empty" hidden={upcoming.length > 0}>
    No upcoming events at this time. Check back soon!
  </p>

  <section class="past-section" id="past-section" hidden={past.length === 0}>
    <h3>Past events</h3>
    <div class="event-list event-list--past" id="past-list">
      {past.map(event => (
        <EventCard
          title={event.data.title}
          date={event.data.date}
          startTime={event.data.startTime}
          endTime={event.data.endTime}
          location={event.data.location}
          type={event.data.type}
          featured={event.data.featured}
          slug={event.id.replace(/\.mdx?$/, '')}
        />
      ))}
    </div>
  </section>

  {/*
    The site is statically built, so the server-side split above is frozen at
    the last deploy date. This corrects only the stragglers: any event that has
    lapsed since the build is moved from upcoming → past in the browser, using
    the visitor's real date. UTC is used to match the server's comparison.
  */}
  <script is:inline>
    (function () {
      var todayUTC = new Date().toISOString().slice(0, 10);
      var upcomingList = document.getElementById('upcoming-list');
      var upcomingEmpty = document.getElementById('upcoming-empty');
      var pastSection = document.getElementById('past-section');
      var pastList = document.getElementById('past-list');
      if (!upcomingList || !pastList) return;

      // Lapsed events are the leading (oldest) entries of the ascending
      // upcoming list. Iterate forward and prepend each to the descending
      // past list so the most recently lapsed ends up on top.
      var cards = Array.prototype.slice.call(upcomingList.children);
      var moved = false;
      for (var i = 0; i < cards.length; i++) {
        var d = cards[i].getAttribute('data-date');
        if (d && d < todayUTC) {
          pastList.insertBefore(cards[i], pastList.firstChild);
          moved = true;
        }
      }

      if (moved) {
        var hasUpcoming = upcomingList.children.length > 0;
        upcomingList.hidden = !hasUpcoming;
        if (upcomingEmpty) upcomingEmpty.hidden = hasUpcoming;
        if (pastSection) pastSection.hidden = false;
      }
    })();
  </script>
</BaseLayout>

<style>
.page-header {
  padding-top: 32px;
  margin-bottom: 24px;
}
.page-header h2 {
  font-size: 24px;
  font-weight: 500;
  color: #1a4d2e;
  margin: 0;
}
.event-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 40px;
}
.event-list--past {
  opacity: 0.7;
}
.empty-state {
  font-family: 'DM Sans', sans-serif;
  color: #888780;
  font-size: 15px;
  margin-bottom: 40px;
}
.past-section h3 {
  font-size: 18px;
  font-weight: 500;
  color: #5F5E5A;
  margin: 0 0 16px;
}
</style>
