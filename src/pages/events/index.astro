---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');

const today = new Date();
today.setUTCHours(0, 0, 0, 0);

const upcoming = allEvents
  .filter(e => e.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = allEvents
  .filter(e => e.data.date < today)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Events | Washington Place Improvement Association">
  <div class="page-header">
    <h2>Upcoming events</h2>
  </div>

  {upcoming.length > 0 ? (
    <div class="event-list">
      {upcoming.map(event => (
        <EventCard
          title={event.data.title}
          date={event.data.date}
          startTime={event.data.startTime}
          endTime={event.data.endTime}
          location={event.data.location}
          type={event.data.type}
          featured={event.data.featured}
          slug={event.id}
        />
      ))}
    </div>
  ) : (
    <p class="empty-state">No upcoming events at this time. Check back soon!</p>
  )}

  {past.length > 0 && (
    <section class="past-section">
      <h3>Past events</h3>
      <div class="event-list event-list--past">
        {past.map(event => (
          <EventCard
            title={event.data.title}
            date={event.data.date}
            startTime={event.data.startTime}
            endTime={event.data.endTime}
            location={event.data.location}
            type={event.data.type}
            featured={event.data.featured}
            slug={event.id}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
.page-header {
  padding-top: 32px;
  margin-bottom: 24px;
}
.page-header h2 {
  font-size: 24px;
  font-weight: 500;
  color: #1a4d2e;
  margin: 0;
}
.event-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 40px;
}
.event-list--past {
  opacity: 0.7;
}
.empty-state {
  font-family: 'DM Sans', sans-serif;
  color: #888780;
  font-size: 15px;
  margin-bottom: 40px;
}
.past-section h3 {
  font-size: 18px;
  font-weight: 500;
  color: #5F5E5A;
  margin: 0 0 16px;
}
</style>
