---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BoardMember from '../../components/BoardMember.astro';
import { getCollection } from 'astro:content';

const boardMembers = await getCollection('board');
const sortedBoard = boardMembers.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Contact | Washington Place Improvement Association">
  <div class="page-header">
    <h2>Contact us</h2>
  </div>

  <div class="contact-grid">
    <div class="card">
      <h3>Get in touch</h3>
      <dl class="contact-info">
        <div class="contact-row">
          <dt>Email</dt>
          <dd><a href="mailto:board@washingtonplace.org">board@washingtonplace.org</a></dd>
        </div>
        <div class="contact-row">
          <dt>Mail</dt>
          <dd>PO Box 1987, Washington Place, MO 63143</dd>
        </div>
        <div class="contact-row">
          <dt>Meetings</dt>
          <dd>First Monday of each month, 7 PM</dd>
        </div>
        <div class="contact-row">
          <dt>Location</dt>
          <dd>Community Center, Room 2</dd>
        </div>
      </dl>
    </div>

    <div class="card">
      <h3>Board members</h3>
      {sortedBoard.map(member => (
        <BoardMember
          name={member.data.name}
          role={member.data.role}
          email={member.data.email}
          order={member.data.order}
        />
      ))}
    </div>
  </div>

  <div class="card form-card">
    <h3>Send us a message</h3>
    <p class="form-intro">Have a question or concern? Fill out the form below and a board member will get back to you.</p>
    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="contact-form"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="sr-only" aria-hidden="true">
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>
      <div class="form-row">
        <div class="form-field">
          <label for="f-name">Name</label>
          <input id="f-name" type="text" name="name" required autocomplete="name" />
        </div>
        <div class="form-field">
          <label for="f-email">Email</label>
          <input id="f-email" type="email" name="email" required autocomplete="email" />
        </div>
      </div>
      <div class="form-field">
        <label for="f-subject">Subject</label>
        <input id="f-subject" type="text" name="subject" required />
      </div>
      <div class="form-field">
        <label for="f-message">Message</label>
        <textarea id="f-message" name="message" rows="5" required></textarea>
      </div>
      <button type="submit" class="submit-btn">Send message</button>
    </form>
  </div>
</BaseLayout>

<style>
.page-header {
  padding-top: 32px;
  margin-bottom: 24px;
}
.page-header h2 {
  font-size: 24px;
  font-weight: 500;
  color: #1a4d2e;
  margin: 0;
}
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 24px;
}
.card {
  background: #fff;
  border: 1px solid #e8e6df;
  border-radius: 12px;
  padding: 28px;
}
.card h3 {
  margin: 0 0 16px;
  font-size: 17px;
  font-weight: 500;
}
.contact-info {
  margin: 0;
  font-family: 'DM Sans', sans-serif;
}
.contact-row {
  margin-bottom: 14px;
}
.contact-row:last-child {
  margin-bottom: 0;
}
.contact-info dt {
  font-size: 11px;
  font-weight: 500;
  color: #888780;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 2px;
}
.contact-info dd {
  margin: 0;
  font-size: 14px;
  color: #2C2C2A;
  line-height: 1.5;
}
.contact-info a {
  color: #1a4d2e;
  text-decoration: none;
}
.contact-info a:hover {
  text-decoration: underline;
}
.form-card {
  margin-bottom: 40px;
}
.form-intro {
  margin: 0 0 20px;
  font-size: 14px;
  color: #5F5E5A;
  font-family: 'DM Sans', sans-serif;
  line-height: 1.5;
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
}
.contact-form {
  font-family: 'DM Sans', sans-serif;
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.form-field {
  display: flex;
  flex-direction: column;
  margin-bottom: 16px;
}
.form-field label {
  font-size: 13px;
  font-weight: 500;
  color: #2C2C2A;
  margin-bottom: 6px;
}
.form-field input,
.form-field textarea {
  border: 1px solid #e8e6df;
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 14px;
  font-family: 'DM Sans', sans-serif;
  color: #2C2C2A;
  background: #fff;
  outline: none;
  transition: border-color 0.15s;
}
.form-field input:focus,
.form-field textarea:focus {
  border-color: #1a4d2e;
}
.form-field textarea {
  resize: vertical;
}
.submit-btn {
  background: #1a4d2e;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 12px 28px;
  font-size: 14px;
  font-weight: 500;
  font-family: 'DM Sans', sans-serif;
  cursor: pointer;
  transition: background 0.15s;
}
.submit-btn:hover {
  background: #2a7a4a;
}

@media (max-width: 640px) {
  .contact-grid {
    grid-template-columns: 1fr;
  }
  .form-row {
    grid-template-columns: 1fr;
  }
}
</style>
