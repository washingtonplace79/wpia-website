---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const recentNews = allNews
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const today = new Date();
today.setUTCHours(0, 0, 0, 0);
const allEvents = await getCollection('events');
// Render a small buffer beyond the 3 shown so the client-side correction
// (see script below) can backfill if a leading event has lapsed since the
// static build, without an extra Netlify rebuild.
const PREVIEW_SHOWN = 3;
const upcomingEvents = allEvents
  .filter(e => e.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, PREVIEW_SHOWN + 3);
---

<BaseLayout title="Washington Place Improvement Association">
  <section class="hero">
    <div class="hero-title-block">
      <span class="hero-eyebrow">Welcome to</span>
      <h2 class="hero-title">Washington Place</h2>
      <p class="hero-tagline">St. Louis, Missouri &nbsp;·&nbsp; 5000–5200 Blocks &nbsp;·&nbsp; Established Circa 1904</p>
    </div>
    <figure class="hero-figure">
      <img src="/images/dogwood-hero.jpg" alt="Dogwood blossoms in the neighborhood" />
    </figure>
  </section>

  <div class="previews-grid">
    <section class="preview-col">
      <h3 class="section-heading">Recent news</h3>
      <div class="preview-list">
        {recentNews.map(post => {
          const formattedDate = post.data.date.toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric',
          });
          return (
            <a href={`/news/${post.id.replace(/\.mdx?$/, '')}/`} class="preview-row">
              <div class="preview-meta">
                <Badge label={post.data.tag} />
                <span class="preview-date">{formattedDate}</span>
              </div>
              <h4 class="preview-title">{post.data.title}</h4>
              <p class="preview-excerpt">{post.data.excerpt.substring(0, 120)}…</p>
            </a>
          );
        })}
      </div>
      <a href="/news/" class="view-all-link">View all news →</a>
    </section>

    <section class="preview-col">
      <h3 class="section-heading">Upcoming events</h3>
      <div class="preview-list" id="events-preview">
        {upcomingEvents.map((event, i) => {
          const formattedDate = event.data.date.toLocaleDateString('en-US', {
            weekday: 'short', month: 'long', day: 'numeric', timeZone: 'UTC',
          });
          const timeRange = event.data.endTime
            ? `${event.data.startTime} – ${event.data.endTime}`
            : event.data.startTime;
          const eventHref = event.data.featured
            ? `/events/${event.id.replace(/\.mdx?$/, '')}/`
            : '/events/';
          return (
            <a
              href={eventHref}
              class="preview-row"
              data-date={event.data.date.toISOString().slice(0, 10)}
              hidden={i >= PREVIEW_SHOWN}
            >
              <div class="preview-meta">
                <Badge label={event.data.type} />
                <span class="preview-date">{formattedDate}</span>
              </div>
              <h4 class="preview-title">{event.data.title}</h4>
              <p class="preview-excerpt">{timeRange} · {event.data.location}</p>
            </a>
          );
        })}
        <p class="empty-state" id="events-preview-empty" hidden={upcomingEvents.length > 0}>
          No upcoming events at this time.
        </p>
      </div>

      {/*
        Static build: the upcoming filter above is frozen at deploy time. Drop
        any rows that have lapsed since, then show the first PREVIEW_SHOWN of
        what remains (the buffer rendered above covers the backfill). UTC to
        match the server-side comparison.
      */}
      <script is:inline define:vars={{ PREVIEW_SHOWN }}>
        (function () {
          var todayUTC = new Date().toISOString().slice(0, 10);
          var list = document.getElementById('events-preview');
          var empty = document.getElementById('events-preview-empty');
          if (!list) return;
          var rows = Array.prototype.slice.call(
            list.querySelectorAll('.preview-row')
          );
          var shown = 0;
          for (var i = 0; i < rows.length; i++) {
            var d = rows[i].getAttribute('data-date');
            var lapsed = d && d < todayUTC;
            var show = !lapsed && shown < PREVIEW_SHOWN;
            rows[i].hidden = !show;
            if (show) shown++;
          }
          if (empty) empty.hidden = shown > 0;
        })();
      </script>
      <a href="/events/" class="view-all-link">View all events →</a>
    </section>
  </div>
</BaseLayout>

<style>
.hero {
  margin: 24px 0 36px;
  text-align: center;
}
.hero-title-block {
  margin: 0 auto 20px;
  max-width: 640px;
}
.hero-eyebrow {
  display: block;
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 15px;
  color: var(--color-text-secondary);
  margin-bottom: 4px;
  letter-spacing: 0.02em;
}
.hero-title {
  margin: 0;
  font-family: var(--font-serif);
  font-weight: 500;
  font-size: 32px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-text);
  line-height: 1.1;
}
.hero-tagline {
  margin: 8px 0 0;
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 14px;
  color: var(--color-text-secondary);
}
.hero-figure {
  margin: 0;
  padding: 0;
}
.hero-figure img {
  display: block;
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 4px;
}
.previews-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  margin-bottom: 40px;
}
.section-heading {
  font-size: 20px;
  font-weight: 500;
  margin: 0 0 16px;
  color: #1a4d2e;
}
.preview-list {
  display: flex;
  flex-direction: column;
  margin-bottom: 16px;
  border-top: 1px solid #f0efe9;
}
.preview-row {
  background: #fff;
  padding: 20px 24px;
  border-bottom: 1px solid #f0efe9;
  display: block;
  text-decoration: none;
  color: inherit;
}
.preview-row:hover {
  background: #fdfcf9;
}
.preview-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
  flex-wrap: wrap;
}
.preview-date {
  font-size: 12px;
  color: #888780;
  font-family: 'DM Sans', sans-serif;
}
.preview-title {
  margin: 0 0 4px;
  font-size: 16px;
  font-weight: 500;
  color: #2C2C2A;
}
.preview-excerpt {
  margin: 0;
  font-size: 14px;
  color: #5F5E5A;
  line-height: 1.5;
  font-family: 'DM Sans', sans-serif;
}
.empty-state {
  padding: 20px 24px;
  background: #fff;
  border-bottom: 1px solid #f0efe9;
  margin: 0;
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  color: #888780;
}
.view-all-link {
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  font-weight: 500;
  color: #1a4d2e;
  text-decoration: none;
}
.view-all-link:hover {
  text-decoration: underline;
}

@media (max-width: 640px) {
  .hero-figure img {
    height: 180px;
  }
  .hero-title {
    font-size: 22px;
    letter-spacing: 0.16em;
  }
  .previews-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}
</style>
