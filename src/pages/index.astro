---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import QuickLinkCard from '../components/QuickLinkCard.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const recentNews = allNews
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const quickLinks = [
  { icon: '📰', label: 'Latest news', desc: 'Announcements & updates', href: '/news/' },
  { icon: '📅', label: 'Upcoming events', desc: 'Calendar & RSVPs', href: '/events/' },
  { icon: '📁', label: 'Documents', desc: 'Bylaws, minutes & more', href: '/documents/' },
];
---

<BaseLayout title="Washington Place Improvement Association">
  <div class="hero">
    <h2>Welcome to our neighborhood</h2>
    <p>Stay connected with your neighbors — find the latest news, upcoming events, and important documents all in one place.</p>
  </div>

  <div class="quick-links">
    {quickLinks.map(link => <QuickLinkCard {...link} />)}
  </div>

  <section>
    <h3 class="section-heading">Recent news</h3>
    <div class="news-preview-list">
      {recentNews.map(post => {
        const formattedDate = post.data.date.toLocaleDateString('en-US', {
          year: 'numeric', month: 'long', day: 'numeric',
        });
        return (
          <a href={`/news/${post.id}/`} class="news-preview-row">
            <div class="news-preview-meta">
              <Badge label={post.data.tag} />
              <span class="preview-date">{formattedDate}</span>
            </div>
            <h4 class="news-preview-title">{post.data.title}</h4>
            <p class="news-preview-excerpt">{post.data.excerpt.substring(0, 120)}…</p>
          </a>
        );
      })}
    </div>
    <a href="/news/" class="view-all-link">View all news →</a>
  </section>
</BaseLayout>

<style>
.hero {
  margin: 32px 0;
  padding: 48px 40px;
  background: linear-gradient(135deg, #1a4d2e 0%, #2a7a4a 100%);
  border-radius: 16px;
  color: #fff;
}
.hero h2 {
  margin: 0 0 12px;
  font-size: 32px;
  font-weight: 600;
  line-height: 1.2;
  color: #fff;
}
.hero p {
  margin: 0;
  font-size: 17px;
  opacity: 0.85;
  max-width: 520px;
  line-height: 1.6;
  font-family: 'DM Sans', sans-serif;
}
.quick-links {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 40px;
}
.section-heading {
  font-size: 20px;
  font-weight: 500;
  margin: 0 0 16px;
  color: #1a4d2e;
}
.news-preview-list {
  display: flex;
  flex-direction: column;
  margin-bottom: 16px;
  border-top: 1px solid #f0efe9;
}
.news-preview-row {
  background: #fff;
  padding: 20px 24px;
  border-bottom: 1px solid #f0efe9;
  display: block;
  text-decoration: none;
  color: inherit;
}
.news-preview-row:hover {
  background: #fdfcf9;
}
.news-preview-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
  flex-wrap: wrap;
}
.preview-date {
  font-size: 12px;
  color: #888780;
  font-family: 'DM Sans', sans-serif;
}
.news-preview-title {
  margin: 0 0 4px;
  font-size: 16px;
  font-weight: 500;
  color: #2C2C2A;
}
.news-preview-excerpt {
  margin: 0;
  font-size: 14px;
  color: #5F5E5A;
  line-height: 1.5;
  font-family: 'DM Sans', sans-serif;
}
.view-all-link {
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  font-weight: 500;
  color: #1a4d2e;
  text-decoration: none;
}
.view-all-link:hover {
  text-decoration: underline;
}

@media (max-width: 640px) {
  .hero {
    padding: 32px 24px;
  }
  .hero h2 {
    font-size: 24px;
  }
  .quick-links {
    grid-template-columns: 1fr;
  }
}
</style>
